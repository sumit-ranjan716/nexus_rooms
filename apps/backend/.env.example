# Server Configuration
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://nexus_user:nexus_password@localhost:5432/nexus_rooms_db

# JWT
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN RSA PUBLIC KEY-----\n...\n-----END RSA PUBLIC KEY-----
REFRESH_TOKEN_SECRET=your-very-secret-refresh-token-key-min-32-chars

# S3 / File Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=nexus-uploads-dev
S3_UPLOADS_PREFIX=rooms/

# App
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
BCRYPT_COST=12
SESSION_MAX_AGE=2592000000
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
REFRESH_TOKEN_SECRET=replace-with-a-32-char-minimum-secret-string

# Email (Optional for MVP)
# AWS_SES_REGION=us-east-1
# SENDER_EMAIL=noreply@nexus.app

# Monitoring (Optional for MVP)
# SENTRY_DSN=
