// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomRole {
  admin
  editor
  viewer
}

enum ContentType {
  pdf
  image
  document
  link
  text
}

model User {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String                   @unique @db.VarChar(320)
  passwordHash          String
  displayName           String?                  @db.VarChar(120)
  avatarUrl             String?
  emailVerified         Boolean                  @default(false)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  // Relations
  rooms                   Room[]
  roomMembers             RoomMember[]
  contentItems            ContentItem[]
  inviteLinks             InviteLink[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  refreshSessions         RefreshSession[]
  folders                 Folder[]
  contentVersions         ContentVersion[]
  comments                Comment[]
  notifications           Notification[]
  activities              ActivityLog[]

  @@map("users")
}

model Room {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String       @unique @db.VarChar(8)
  name              String       @db.VarChar(120)
  description       String?      @db.VarChar(500)
  passwordHash      String?
  createdBy         String       @db.Uuid
  isDeleted         Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  creator           User         @relation(fields: [createdBy], references: [id])
  members           RoomMember[]
  contentItems      ContentItem[]
  inviteLinks       InviteLink[]
  folders           Folder[]
  tags              Tag[]
  notifications     Notification[]
  activities        ActivityLog[]

  @@index([createdBy])
  @@index([slug])
  @@index([createdBy, isDeleted])
  @@map("rooms")
}

model RoomMember {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId            String    @db.Uuid
  userId            String    @db.Uuid
  role              RoomRole  @default(viewer)
  joinedAt          DateTime  @default(now())

  // Relations
  room              Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, role])
  @@index([userId])
  @@index([roomId])
  @@map("room_members")
}

model InviteLink {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId            String    @db.Uuid
  token             String    @unique @db.VarChar(128)
  role              RoomRole  @default(viewer)
  createdBy         String    @db.Uuid
  expiresAt         DateTime?
  isSingleUse       Boolean   @default(false)
  usedAt            DateTime?
  isRevoked         Boolean   @default(false)
  createdAt         DateTime  @default(now())

  // Relations
  room              Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  creator           User      @relation(fields: [createdBy], references: [id])

  @@index([roomId])
  @@index([token])
  @@index([roomId, isRevoked, expiresAt])
  @@map("invite_links")
}

model ContentItem {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId            String       @db.Uuid
  folderId          String?      @db.Uuid
  createdBy         String       @db.Uuid
  type              ContentType
  title             String       @db.VarChar(255)
  storageKey        String       @unique @db.VarChar(512)
  fileSizeBytes     Int
  mimeType          String?      @db.VarChar(255)
  metadata          Json?        // { width, height } for images, etc.
  isDeleted         Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  room              Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  folder            Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  creator           User             @relation(fields: [createdBy], references: [id])
  versions          ContentVersion[]
  tags              ContentTag[]
  comments          Comment[]
  notifications     Notification[]

  @@index([roomId])
  @@index([folderId])
  @@index([createdBy])
  @@index([type])
  @@index([roomId, isDeleted, createdAt])
  @@map("content_items")
}

model PasswordResetToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  token             String    @unique @db.VarChar(128)
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, usedAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  token             String    @unique @db.VarChar(128)
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model RefreshSession {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @db.Uuid
  familyId            String    @db.Uuid
  tokenHash           String    @unique @db.VarChar(128)
  rotatedFromSessionId String?  @db.Uuid
  revokedAt           DateTime?
  expiresAt           DateTime
  lastUsedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Folder {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String   @db.Uuid
  parentId  String?  @db.Uuid
  name      String   @db.VarChar(120)
  createdBy String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  creator      User          @relation(fields: [createdBy], references: [id])
  parent       Folder?       @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders   Folder[]      @relation("FolderToFolder")
  contentItems ContentItem[]

  @@index([roomId])
  @@index([parentId])
  @@map("folders")
}

model ContentVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentItemId String   @db.Uuid
  versionNumber Int
  storageKey    String   @db.VarChar(512)
  snapshot      Json?    // Optional JSON snapshot for rich text versions
  createdBy     String   @db.Uuid
  createdAt     DateTime @default(now())
  changeSummary String?  @db.VarChar(255)

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  creator     User        @relation(fields: [createdBy], references: [id])

  @@index([contentItemId])
  @@map("content_versions")
}

model Tag {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String       @db.Uuid
  name      String       @db.VarChar(50)
  color     String       @db.VarChar(20) // e.g. HSL or tailwind palette
  createdAt DateTime     @default(now())

  room         Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  contentItems ContentTag[]

  @@unique([roomId, name])
  @@index([roomId])
  @@map("tags")
}

model ContentTag {
  contentItemId String @db.Uuid
  tagId         String @db.Uuid

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentItemId, tagId])
  @@map("content_tags")
}

model Comment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentItemId String   @db.Uuid
  parentId      String?  @db.Uuid
  authorId      String   @db.Uuid
  body          String   @db.Text
  isEdited      Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent      Comment?    @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]   @relation("CommentToComment")

  @@index([contentItemId])
  @@index([parentId])
  @@map("comments")
}

model Notification {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @db.Uuid
  roomId        String   @db.Uuid
  contentItemId String?  @db.Uuid
  type          String   @db.VarChar(50)
  payload       Json
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId     String   @db.Uuid
  actorId    String   @db.Uuid
  action     String   @db.VarChar(50)
  targetType String   @db.VarChar(50)
  targetId   String?  @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now())

  room  Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([roomId, createdAt])
  @@map("activity_log")
}
